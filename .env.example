# Application
APP_NAME=Code Review Agent
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
DATABASE_URL=sqlite:///./data/code_review_agent.db
DEMO_MODE=false
MAX_DIFF_CHARS=60000

# Hindsight
# Local Hindsight:
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Hindsight's own extraction/consolidation LLM.
# Groq is recommended by the Hindsight documentation for fast inference.
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=gpt-oss-20b

# Review LLM (OpenAI-compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.15

# Optional GitHub token. Public PRs work without one.
GITHUB_TOKEN=

# Frontend
VITE_API_BASE=
